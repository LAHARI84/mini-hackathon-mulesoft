<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<http:listener-config name="HTTP_Listener_config1" doc:name="HTTP Listener config" doc:id="9e9464fa-da88-4bb2-87f6-952e68e5db38" >
		<http:listener-connection host="0.0.0.0" port="8084" />
	</http:listener-config>
	<flow name="hr-system-apiFlow" doc:id="ed0b5873-7f0c-4b8d-a1c1-88ddbf81793c" >
		<http:listener doc:name="Listener" doc:id="71300b5b-d775-40dc-b7d3-2e4309707e36" config-ref="HTTP_Listener_config1" path="/hr/eligibility/{employeeId}"/>
		<choice doc:name="Choice" doc:id="c0fba9d5-22e5-4d2d-affe-5a85d27b1b97" >
			<when expression='#[attributes.uriParams.employeeId == "EMP999"]'>
				<set-payload value='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    employeeId: attributes.uriParams.employeeId,&#10;    eligible: false,&#10;    employmentStatus: "INACTIVE"&#10;}]' doc:name="Set Payload" doc:id="51eba546-0dff-4467-b190-76b31ec6358a" />
			</when>
			<otherwise>
				<set-payload value='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    employeeId: attributes.uriParams.employeeId,&#10;    eligible: true,&#10;    employmentStatus: "ACTIVE"&#10;}]' doc:name="Set Payload" doc:id="c4ea4c8f-2cde-4f69-9488-9ecdd465645d" />
			</otherwise>
		</choice>
	</flow>
</mule>
